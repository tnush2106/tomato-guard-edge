# Rename API keys, DO NOT commit .env with real keys
# Dashboard login: run `python deploy/set_dashboard_password.py` on the Pi.
# This creates DASHBOARD_USERNAME, DASHBOARD_PASSWORD_HASH, and FLASK_SECRET_KEY
# in .env. Keep .env private. The default Secure cookie requires HTTPS.
# For local HTTP testing only, set DASHBOARD_COOKIE_SECURE=0.
DASHBOARD_COOKIE_SECURE=1
OPENAI_API_KEY=sk-your-openai-api-key-here
TAVILY_API_KEY=tvly-your-tavily-api-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# Chatbot provider: openrouter, openai, google, or auto.
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=openrouter/free
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=0
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-3.6-flash

# Vision model. NCNN is the default backend for Raspberry Pi 4.
MODEL_PATH=model/tomato_6cls_ncnn_model
LAPTOP_MODEL_PATH=../yolo26n_tomato_6cls_complete/training_results/weights/best.pt
MODEL_IMGSZ=640
MODEL_CONFIDENCE=0.35
INFERENCE_FPS=3

# ESP32 HAT UART2 (Pi header pins 8/TX, 10/RX, common GND)
HAT_ENABLED=1
HAT_SERIAL_PORT=/dev/serial0
HAT_BAUDRATE=115200
HAT_STALE_SECONDS=6
HAT_COMMAND_TIMEOUT=2.5
HAT_OFFLINE_SIMULATION=1
